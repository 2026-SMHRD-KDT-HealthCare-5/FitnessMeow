generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model achievements {
  achieve_idx Int      @id @default(autoincrement())
  user_idx    Int
  badge_idx   Int
  created_at  DateTime @db.DateTime(0)

  @@index([badge_idx], map: "FK_achievements_badge_idx_badges_badge_idx")
  @@index([user_idx], map: "FK_achievements_user_idx_users_user_idx")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model attendances {
  attendance_idx Int      @id @default(autoincrement())
  user_idx       Int
  addtend_date   DateTime @db.Date
  streak_count   Int      @db.TinyInt
  reward_given   Int      @db.TinyInt

  @@index([user_idx], map: "FK_attendances_user_idx_users_user_idx")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model badges {
  badge_idx     Int    @id @default(autoincrement())
  badge_keyword String @unique(map: "UQ_badges_1") @db.VarChar(50)
  badge_name    String @db.VarChar(100)
  badge_desc    String @db.Text
  icon_name     String @db.VarChar(255)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model characters {
  character_idx Int              @id @default(autoincrement())
  user_idx      Int
  animal_type   String           @db.VarChar(20)
  level         characters_level
  arm_exp       Int              @default(0)
  chest_exp     Int              @default(0)
  core_exp      Int              @default(0)
  lower_exp     Int              @default(0)
  is_unlocked   Int              @default(0) @db.TinyInt
  created_at    DateTime         @default(now()) @db.DateTime(0)

  @@index([user_idx], map: "FK_characters_user_idx_users_user_idx")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model coordinates {
  coord_idx Int @id @default(autoincrement())
  user_idx  Int
  item_idx  Int
  pos_x     Int @default(0)
  pos_y     Int @default(0)

  @@index([user_idx], map: "FK_coordinates_user_idx_users_user_idx")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model quests {
  quest_idx  Int    @id @default(autoincrement())
  quest_type String @db.VarChar(50)
  quest_name String @db.VarChar(50)
  quest_desc String @db.VarChar(50)
  goal_count Int?
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model shop_items {
  item_idx     Int    @id @default(autoincrement())
  item_keyword String @unique(map: "UQ_shop_items_1") @db.VarChar(50)
  item_name    String @db.VarChar(100)
  category     String @db.VarChar(30)
  price        Int    @default(0)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model user_items {
  purchase_idx Int      @id @default(autoincrement())
  user_idx     Int
  item_idx     Int
  purchased_at DateTime @db.DateTime(0)
  quantity     Int

  @@index([item_idx], map: "FK_user_items_item_idx_shop_items_item_idx")
  @@index([user_idx], map: "FK_user_items_user_idx_users_user_idx")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model user_quests {
  uquest_idx     Int      @id @default(autoincrement())
  user_idx       Int
  quest_idx      Int
  is_completed   Boolean
  ref_date       DateTime @db.Date
  progress_count Int

  @@index([quest_idx], map: "FK_user_quests_quest_idx_quests_quest_idx")
  @@index([user_idx], map: "FK_user_quests_user_idx_users_user_idx")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model users {
  user_idx      Int      @id @default(autoincrement())
  id            String   @unique(map: "UQ_users_id") @db.VarChar(50)
  name          String   @unique(map: "UQ_users_2") @db.VarChar(50)
  email         String   @unique(map: "UQ_users_1") @db.VarChar(100)
  password_hash String   @db.VarChar(255)
  weight        Decimal  @db.Decimal(5, 2)
  height        Decimal  @db.Decimal(5, 2)
  bmi           Decimal  @db.Decimal(5, 2)
  point         Int      @default(0)
  created_at    DateTime @default(now()) @db.DateTime(0)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model workout_records {
  workout_idx   Int      @id @default(autoincrement())
  user_idx      Int
  exercise_key  String   @db.VarChar(30)
  sets          Int      @default(0) @db.TinyInt
  reps          Int      @default(0) @db.TinyInt
  total_score   Decimal  @default(0.00) @db.Decimal(5, 2)
  calories      Decimal  @default(0.00) @db.Decimal(6, 2)
  perfect_count Int      @default(0) @db.TinyInt
  good_count    Int      @default(0) @db.TinyInt
  poor_count    Int      @default(0) @db.TinyInt
  performed_at  DateTime @default(now()) @db.DateTime(0)

  @@index([user_idx], map: "FK_workout_records_user_idx_users_user_idx")
}

enum characters_level {
  one   @map("1")
  two   @map("2")
  three @map("3")
}
